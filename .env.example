# ---------------------------------------------------------------------------
# Refino de copy por IA — DESLIGADO por padrao.
#
# O app funciona inteiro sem isto: a copy de regras e a versao revisada por
# humano e cobre todos os textos. O refino por IA e um acabamento opcional.
#
# Para ligar: ter credito na conta OpenAI, preencher a chave e usar ELIH_IA=1.
# Com ELIH_IA=0 (ou ausente) nenhuma chamada a API e feita — nao gasta credito
# nem tempo esperando resposta.
# ---------------------------------------------------------------------------
ELIH_IA=0
OPENAI_API_KEY=

# Modelo do refino, quando ligado. Os tres passaram 4/4 na validacao
# anti-alucinacao com a carga real:
#   gpt-4.1-nano  ~R$0,0016 por proposta  (mais barato)
#   gpt-4o-mini   ~R$0,0023 por proposta  (padrao)
#   gpt-4.1-mini  ~R$0,0063 por proposta  (texto um pouco mais fluido)
ELIH_MODELO_IA=gpt-4o-mini

# Porta do servidor (Easypanel costuma injetar isso automaticamente).
PORT=8000
