# Opcional. Sem esta chave o gerador usa apenas o motor de copy por regras —
# todos os recursos continuam funcionando, sem custo e sem latencia de API.
OPENAI_API_KEY=

# Modelo do refinamento de copy. Todos os tres abaixo passaram 4/4 na validacao
# anti-alucinacao com a carga real; o texto sai equivalente:
#   gpt-4.1-nano  ~R$0,0016 por proposta  (mais barato)
#   gpt-4o-mini   ~R$0,0023 por proposta  (padrao)
#   gpt-4.1-mini  ~R$0,0063 por proposta  (texto um pouco mais fluido)
ELIH_MODELO_IA=gpt-4o-mini

# Porta do servidor (Easypanel costuma injetar isso automaticamente).
PORT=8000
